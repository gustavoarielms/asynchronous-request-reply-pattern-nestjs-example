{
  "name": "nestjs-async-request-reply",
  "version": "0.0.10",
  "description": "NestJS library for asynchronous request-reply HTTP flows backed by BullMQ and Redis.",
  "author": "gustavoarielms",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavoarielms/asynchronous-request-reply-pattern-nestjs-example.git"
  },
  "homepage": "https://github.com/gustavoarielms/asynchronous-request-reply-pattern-nestjs-example#readme",
  "bugs": {
    "url": "https://github.com/gustavoarielms/asynchronous-request-reply-pattern-nestjs-example/issues"
  },
  "main": "dist/lib/async/index.js",
  "types": "dist/lib/async/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/async/index.d.ts",
      "require": "./dist/lib/async/index.js",
      "default": "./dist/lib/async/index.js"
    }
  },
  "files": [
    "dist/lib/async",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "nest build",
    "build:package": "tsc -p tsconfig.package.json --incremental false",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pack:dry-run": "npm pack --dry-run",
    "publish:npm": "npm publish --access public",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "smoke:example": "node ./scripts/smoke-example.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "bullmq": "^5.74.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "bullmq": "^5.74.1",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "apps/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
